{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.files/python-mcp",
  "description": "Local-only Python MCP server for the Files.com API.",
  "repository": {
    "url": "https://github.com/Files-com/files-mcp",
    "source": "github"
  },
  "version": "1.0.87",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "files-com-mcp",
      "version": "1.0.87",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Files.com API key used by the local MCP server to authenticate API requests.",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "FILES_COM_API_KEY"
        }
      ]
    }
  ]
}
